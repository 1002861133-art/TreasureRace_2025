<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TreasureRace_2025.EndGamePage"
             Title="המרוץ למיליון - בית ספר טשרניחובסקי 2026"
             FlowDirection="RightToLeft"
             BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="24"
            VerticalOptions="Center">

            <!-- Logo -->
            <Image
                Source="logo_school.jpg"
                HeightRequest="140"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <!-- Thank you -->
            <Label
                Text="תודה שהשתתפת במשחק!"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                TextColor="#1F2937" />

            <Label
                Text="המרוץ למיליון - בית ספר טשרניחובסקי 2026"
                FontSize="16"
                HorizontalTextAlignment="Center"
                TextColor="#6B7280" />

            <!-- Score Card -->
            <Frame
                BackgroundColor="White"
                CornerRadius="20"
                Padding="24"
                HasShadow="True"
                HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="הציון של הקבוצה שלך הוא: "
                        FontSize="20"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="#374151" />

                    <Label
                        x:Name="lblFinalSAcore"
                        FontSize="56"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="#2563EB" />

                </VerticalStackLayout>
            </Frame>

            <!-- Footer -->
            <Label
                Text="האפליקציה נבנתה על ידי תלמידי מגמת מחשבים י״א תיכון טשרנחובסקי"
                FontSize="14"
                HorizontalTextAlignment="Center"
                TextColor="#6B7280" />

            <!-- Exit Button -->
            <Button
                    x:Name="btnExitApp"
                    Text="סיום (סגירת המשחק)"
                    FontSize="20"
                    FontAttributes="Bold"
                    BackgroundColor="#EF4444"
                    TextColor="White"
                    CornerRadius="12"
                    Clicked="BtnExitApp_Clicked"
                    HorizontalOptions="Fill"/>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
