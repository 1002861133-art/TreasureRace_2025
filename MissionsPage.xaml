<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TreasureRace_2025.MissionsPage"
             Title="המרוץ למיליון - בית ספר טשרניחובסקי 2026"
  			 FlowDirection="RightToLeft"
             BackgroundColor="#F5F7FA">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Logo -->
            <Image Source="logo_school.jpg"
                   HeightRequest="80"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   SemanticProperties.Description="School Logo" />

            <!-- Status Cards: Time Left & Points -->
            <HorizontalStackLayout Spacing="16" HorizontalOptions="CenterAndExpand" >

                <Frame BackgroundColor="#FFE4B5" CornerRadius="12" Padding="12" HasShadow="True" HorizontalOptions="FillAndExpand">
                    <HorizontalStackLayout HorizontalOptions="FillAndExpand">
                        <Label Text="הזמן שנשאר: " FontSize="18" FontAttributes="Bold" TextColor="#1F2937"/>
                        <Label x:Name="lblTimeLeft" Text="20:00" FontSize="18" TextColor="#1F2937" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                    </HorizontalStackLayout>
                </Frame>

                <Frame BackgroundColor="#D3D3D3" CornerRadius="12" Padding="12" HasShadow="True" HorizontalOptions="FillAndExpand">
                    <HorizontalStackLayout HorizontalOptions="FillAndExpand">
                        <Label Text="הנקודות של הקבוצה שלכם: " FontSize="18" FontAttributes="Bold" TextColor="#1F2937"/>
                        <Label x:Name="lblPoints" Text="0" FontSize="18" TextColor="#1F2937" HorizontalOptions="EndAndExpand" HorizontalTextAlignment="End"/>
                    </HorizontalStackLayout>
                </Frame>

            </HorizontalStackLayout>

            <!-- Message / Instructions -->
            <Frame BackgroundColor="#556B2F" CornerRadius="12" Padding="12" HasShadow="True">
                <Label x:Name="lblMsg"
                       Text="ברוך הבא למשחק! , לפניך יוצגו 16 משימות,כל משימה 8 דקות, בכל משימה תתבקש ללכת לחדר מסוים,שם תחכה לך משימה בגליון דף, עליך לבצע אותה או להמשיך למשימה הבאה... בהצלחה!"
                       FontSize="16"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"/>
            </Frame>

            <!-- Mission Card -->
            <Frame BackgroundColor="White" CornerRadius="20" Padding="16" HasShadow="True">
                <VerticalStackLayout Spacing="16">

                    <!-- Mission Number -->
                    <Label x:Name="lblMissionNum"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#374151"
                           HorizontalTextAlignment="Center"/>

                    <!-- Mission Place -->
                    <Label x:Name="lblMissionPlace"
                           FontSize="22"
                           TextColor="#6B21A8"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold"/>

                    <!-- Mission Name -->
                    <Label x:Name="lblMissionName"
                           FontSize="32"
                           TextColor="#6B21A8"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold"/>

                    <!-- Answer Input -->
					<!-- Answer Input -->
					<Grid ColumnDefinitions="Auto,*"
						  ColumnSpacing="12"
						  VerticalOptions="Center">

						<Label Text="תשובה נכונה:"
							   FontSize="16"
							   VerticalTextAlignment="Center"/>

						<Entry x:Name="entAnswer"
							   Grid.Column="1"
							   FontSize="16"
							   Placeholder="הקלד כאן את התשובה לשאלה"/>
					</Grid>

                    <!-- Check Answer Button -->
                    <Button x:Name="btnCheckAnswer"
                            Text="בדוק את השאלה"
                            FontSize="18"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            CornerRadius="12"
                            Clicked="BtnCheckAnswer_Clicked"
                            HorizontalOptions="FillAndExpand"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Navigation Buttons -->
            <HorizontalStackLayout Spacing="16" HorizontalOptions="CenterAndExpand">
                <Button x:Name="btnNextMission"
                        Text="עבור לשאלה הבאה"
                        FontSize="18"
                        BackgroundColor="#6B21A8"
                        TextColor="White"
                        CornerRadius="12"
                        Clicked="BtnNextMission_Clicked"
                        HorizontalOptions="FillAndExpand"/>

                <Button x:Name="btnEndGame"
                        Text="סיים משחק"
                        FontSize="18"
                        BackgroundColor="White"
                        TextColor="#6B21A8"
                        BorderColor="#6B21A8"
                        BorderWidth="2"
                        CornerRadius="12"
                        Clicked="BtnEndGame_Clicked"
                        HorizontalOptions="FillAndExpand"/>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
