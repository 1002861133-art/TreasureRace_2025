<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TreasureRace_2025.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TreasureRace_2025"
    Shell.FlyoutBehavior="Disabled"
    Title="TreasureRace_2025">

    <ShellContent
        Title="Game"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
         Title="Missions Game"
         ContentTemplate="{DataTemplate local:MissionsPage}"
         Route="MissionsPage" />
    <ShellContent
         Title="End Game"
         ContentTemplate="{DataTemplate local:EndGamePage}"
         Route="EndGamePage" />

</Shell>
