<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TreasureRace_2025.MainPage"
             BackgroundColor="#F5F7FA"
             FlowDirection="RightToLeft"
             Title="המרוץ למיליון - בית ספר טשרניחובסקי 2026">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24" VerticalOptions="Center">

            <!-- Logos -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">
                <Image Source="logo_school.jpg"
                       HeightRequest="80"
                       Aspect="AspectFit"
                       SemanticProperties.Description="School Logo" />
                <Image Source="dotnet_bot.png"
                       HeightRequest="80"
                       Aspect="AspectFit"
                       SemanticProperties.Description=".NET Bot Logo" />
            </HorizontalStackLayout>

            <!-- Title -->
            <Label Text="המרוץ אחר המטמון"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="#1F2937"
                   SemanticProperties.HeadingLevel="Level1" />

            <!-- Group Info Card -->
            <Frame BackgroundColor="White"
                   CornerRadius="20"
                   Padding="16"
                   HasShadow="True"
                   HorizontalOptions="Fill">

                <VerticalStackLayout Spacing="16">

                    <!-- Group Name / Number -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12"
                              HorizontalOptions="FillAndExpand"
                              VerticalOptions="Center">

                            <!-- Entry לשם הקבוצה: יתפוס את כל השטח הפנוי -->
                            <Entry x:Name="entGroupName"
                                   Placeholder="שם הקבוצה"
                                   FontSize="16"
                                             HorizontalOptions="FillAndExpand"/>

                            <!-- Entry למספר הקבוצה: רוחב קבוע -->
                            <Entry x:Name="entGroupNumber"
                                   Placeholder="מספר קבוצה"
                                   Keyboard="Numeric"
                                   FontSize="16"
                                   Grid.Column="1"/>
                    </Grid>

                    <!-- Players List Label -->
                    <Label Text="רשימת השחקנים בקבוצה"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#374151" />

                    <!-- Players Grid -->
                    <Grid RowSpacing="12" ColumnSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Player Entries -->
                        <Entry Grid.Row="0" Grid.Column="0" x:Name="entPlayer1" Placeholder="שם השחקן הראשון." FontSize="16"/>
                        <Entry Grid.Row="0" Grid.Column="1" x:Name="entPlayer2" Placeholder="שם השחקן השני." FontSize="16"/>
                        <Entry Grid.Row="1" Grid.Column="0" x:Name="entPlayer3" Placeholder="שם השחקן השלישי." FontSize="16"/>
                        <Entry Grid.Row="1" Grid.Column="1" x:Name="entPlayer4" Placeholder="שם השחקן הרביעי." FontSize="16"/>
                        <Entry Grid.Row="2" Grid.Column="0" x:Name="entPlayer5" Placeholder="שם השחקן החמישי." FontSize="16"/>
                        <Entry Grid.Row="2" Grid.Column="1" x:Name="entPlayer6" Placeholder="שם השחקן השישי." FontSize="16"/>
                        <Entry Grid.Row="3" Grid.Column="0" x:Name="entPlayer7" Placeholder="שם השחקן השביעי." FontSize="16"/>
                        <Entry Grid.Row="3" Grid.Column="1" x:Name="entPlayer8" Placeholder="שם השחקן השמיני." FontSize="16"/>
                        <Entry Grid.Row="4" Grid.Column="0" x:Name="entPlayer9" Placeholder="שם השחקן התשיעי." FontSize="16"/>
                        <Entry Grid.Row="4" Grid.Column="1" x:Name="entPlayer10" Placeholder="שם השחקן העשירי." FontSize="16"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Start Game Button -->
            <Button x:Name="btnStartGame"
                    Text="התחל את המרוץ!!"
                    FontSize="20"
                    FontAttributes="Bold"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    CornerRadius="12"
                    Clicked="BtnStartGame_Clicked"
                    HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
